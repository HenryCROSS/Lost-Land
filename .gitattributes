# 跨 Windows / Linux 开发的行尾统一策略。
#
# 不统一的话，同一个文件在两个平台上会产生整文件的 diff 噪声，
# 让 git blame 和 code review 彻底失效。
#
# 策略：仓库内一律存 LF；检出时也保持 LF（现代编辑器与 MSVC 均支持）。

# 默认：自动识别文本，仓库内统一存 LF
* text=auto eol=lf

# 源码与配置：明确声明为文本
*.rs      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.scm     text eol=lf
*.ftl     text eol=lf
*.wgsl    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Windows 批处理必须是 CRLF，否则 cmd.exe 解析异常
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 资产：二进制，禁止任何行尾转换与 diff 尝试
*.png     binary
*.jpg     binary
*.webp    binary
*.ogg     binary
*.wav     binary
*.flac    binary
*.ttf     binary
*.otf     binary
*.bin     binary
*.pack    binary
*.sav     binary
