// 示例 mod 的天赋——搬自此前的 gameplay.scm。
//
// 六条追加指令（-resource-pool / -resource-pool-by-level /
// -resistance / -sneak-attack / -inspection-suspicion /
// -inspection-concealment）全部变成字段。其中按等级分档的法术位授予
// 此前是「每个等级断点一次调用」，现在是 levels 数组里的一项——合并
// 成同一条 ByLevel 授予的逻辑仍在 TraitTable 里，没有在 schema 侧
// 重写一遍。
{
  traits: [
    {
      // 龙息天赋：只授予一个技能，没有别的效果。
      id: "examplemod:draconic_breath",
      display_name_key: "examplemod:draconic_breath_display_name",
      granted_skills: ["examplemod:breath_weapon"],
    },
    {
      // 天生术法：给 20 点施法点，容量不随等级变。
      id: "examplemod:innate_sorcery",
      display_name_key: "examplemod:innate_sorcery_display_name",
      resource_pools: [
        { pool: "examplemod:sorcery_points", kind: "fixed", amount: 20 },
      ],
    },
    {
      // 奥术施法：法术位随等级开档——1 级两个一阶，5 级四个一阶三个
      // 二阶，9 级再多两个三阶。
      id: "examplemod:arcane_casting",
      display_name_key: "examplemod:arcane_casting_display_name",
      resource_pools: [
        {
          pool: "examplemod:wizard_spell_slots",
          kind: "by-level",
          levels: [
            { level: 1, tiers: [2, 0, 0, 0] },
            { level: 5, tiers: [4, 3, 0, 0] },
            { level: 9, tiers: [4, 3, 2, 0] },
          ],
        },
      ],
    },
    {
      // 德鲁伊施法：只有一个断点，用来对照「多断点」那条。
      id: "examplemod:druidic_casting",
      display_name_key: "examplemod:druidic_casting_display_name",
      resource_pools: [
        {
          pool: "examplemod:druid_slots",
          kind: "by-level",
          levels: [{ level: 1, tiers: [3, 0, 0] }],
        },
      ],
    },
    {
      // 酸性皮膜：天赋那一路的抗性来源，与 acid_ward_amulet（装备
      // 那一路）写进同一个 RuleModifier::Resistance。
      //
      // 减伤 4 点，加值类型「天生」。两个数各自的理由：
      //
      // - **4 点**：这条天赋此前是 500‰ 乘数（半伤）。减伤模型下没有
      //   「半伤」这种与来伤大小无关的表达，只能挑一个点数，于是挑在
      //   本 mod 真实酸伤量级的一半附近——酸蚀匕首走 iron_sword_formula
      //   （攻击力 + 力量调整值），测试夹具里打出的裸伤在个位数到十位
      //   数低段，4 点因此对小刀伤显著、对大伤害明显不够，正是 DR 想要
      //   的战术味（见 RuleModifier::Resistance 文档「对小伤害强、对大
      //   伤害弱」一节）。
      // - **innate**：这是软泥怪的体质，不来自任何外物。与护符的
      //   enhancement 分属两类，于是一只戴着护符的软泥怪两条都吃到、
      //   点数相加（4 + 3 = 7）；而两枚同样的护符仍然只算一枚。
      id: "examplemod:acid_hide",
      display_name_key: "examplemod:acid_hide_display_name",
      rule_modifiers: [
        {
          kind: "resistance",
          damage_category: "examplemod:acid",
          damage_reduction: 4,
          modifier_type: "examplemod:innate",
        },
        // 怕火：本仓库第一条 `kind: "vulnerability"` 声明，也是易伤与
        // 减伤对称批次的端到端证据（crates/ll-mod/tests/
        // example_mod_resistance.rs 的「软泥怪对火易伤」两条）。
        //
        // ── 为什么是 4 ──────────────────────────────────────────
        // 与同一条天赋的抗酸点数**逐字相同**。这不是平衡调参，是一条
        // 可复述、可核对的内容规则：同一具躯体，耐得住多少酸就同样
        // 怕多少火。挑任何别的数都需要一条独立论证，而这条天赋里没有
        // 任何东西能支持那样一条论证——「酸对它比火更无害」是一句可以
        // 说，但本 mod 至今没有任何设定支持的话。
        //
        // 刻意**不**写成 `damage_reduction: -4`：那条写法已经撤销，
        // 理由见 ll_sim::rule_modifier::RuleModifier::Resistance 文档
        // 「脆弱**不**用负减伤表达」一节——同一个加值类型桶里「取最强」
        // 会让 -4 被同桶的任何一条正减伤静默吃掉。
        //
        // ── 为什么是 lostland:fire，不是自己注册一个火类别 ────────
        // 本体 04f5aa3 已经注册了 lostland:fire，example_mod 也已经
        // 声明依赖本体（见 mod.json5）。跨命名空间引用一条已注册的
        // 伤害类别，顺便证明易伤与抗性一样吃得下跨 mod 的类别引用。
        //
        // ── innate ────────────────────────────────────────────────
        // 与抗酸那条同类型：都是这具躯体自带的。它们**不会**互相争
        // 「同类型取最强」——两个消费者各自聚合各自的变体，见
        // ll_sim::rule_modifier::vulnerability_damage_increase 文档。
        {
          kind: "vulnerability",
          damage_category: "lostland:fire",
          damage_increase: 4,
          modifier_type: "examplemod:innate",
        },
      ],
    },
    {
      // 掠食本能：偷袭判定上加半颗骰子（9 点，见
      // ll_sim::check::CheckDice::half_die「给被动天赋定价用的单位」），
      // 触发多打 15 点。潜行时还会再加一整颗骰子，两条加起来恰好等于
      // 修正上限 28，不触发钳制——见 ll_sim::combat::STEALTH_SNEAK_MODIFIER。
      // 本条此前写的是 luck_chance_permille_per_point: 20（每点幸运换
      // 20‰ 触发率），偷袭迁进对抗判定后量尺换了，字段随之改名。
      id: "examplemod:predatory_instinct",
      display_name_key: "examplemod:predatory_instinct_display_name",
      rule_modifiers: [
        { kind: "sneak-attack", sneak_modifier: 9, extra_damage: 15 },
      ],
    },
    {
      // 影舞：**副职**授予的天赋——本仓库里唯一一条挂在
      // SubclassDef.traits 上的天赋，端到端证据见
      // crates/ll-mod/tests/example_mod_subclass_traits.rs。
      //
      // 只授予一个技能、没有别的效果，与龙息那条同形。授予的是既有的
      // examplemod:backstab（不新造技能）——「影舞者」与背刺在题材上
      // 本来就是一回事，而复用一条已存在的技能正是「主职与副职共享同一
      // 份技能命名空间」这条裁定（ll_mod::subclass 模块文档「裁定
      // P5-4」一节）的真实用例：同一个技能既能由职业天赋授予（盗贼的
      // 扒手训练，3 级），也能由副职天赋授予（本条，拥有即生效），
      // 不需要复制一份技能定义，也不需要任何跨命名空间引用机制。
      id: "examplemod:shadow_dance",
      display_name_key: "examplemod:shadow_dance_display_name",
      granted_skills: ["examplemod:backstab"],
    },
    {
      // 扒手训练：盗贼被动的两种——「不觉得可疑」与「查不出东西」。
      // 两者落在盘查链路的两环：前者在卫兵决定要不要发起盘查那一步，
      // 后者在盘查已经发起、结算搜出什么那一步。
      //
      // 判定系统落地批次把两条都换成了**判定修正点数**（此前一条是
      // 「减 400‰ 触发率」、一条是「800‰ 逐件藏匿概率」）。两个数字
      // 都不再是概率，而是加在**隐蔽那一方掷出的点数上**的整数——
      // 判定用 3d20，见 ll_sim::check。
      //
      // 两条都取 9，理由是同一条：**半颗骰子的跨度**（(N−1)/2，N=20
      // 时是 9，见 ll_sim::check::CheckDice::half_die）。不是拟合出来
      // 的数——
      //
      //   * 需要一个有内在依据的档位，而这把尺子上自明的单位只有
      //     「一整颗骰子」（19）和「半颗」（9）；
      //   * 「一整颗」已经被**主动潜行**占了
      //     （ll_mod::native_behavior::GUARD_INSPECT_STEALTH_MODIFIER）。
      //     一条天生的被动不该与「此刻真的藏起来了」等价，取它的一半
      //     是唯一有理由的选择；
      //   * 两者叠加恰好是 28 = 修正上限，不触发钳制。再大一点，潜行
      //     就会把天赋吃掉大半——那正是旧模型「乘法档吃掉加法量」的
      //     同一个病换个地方犯。
      //
      // 数值后果如实记下（双方属性均为基准 10，两侧调整值均为 0）：
      //
      //   * 盘查触发率：常态 500‰ → 486‰（几乎逐字不变），仅天赋
      //     100‰ → 255‰（弱了），潜行 + 天赋 1‰ → 21‰（强了）。
      //     旧模型那个 1‰ 不是设计，是概率钳制的兜底留下的痕迹。
      //   * 逐件藏匿：800‰ → 745‰（同一档），且**搜身的人是谁**第一次
      //     开始影响结果——旧模型下眼神再好的卫兵与瞎子查同一个人，
      //     查到的东西逐位相同。
      //
      // 两条都不声明加值类型：本 mod 里没有第二条盘查类被动，分不分类
      // 观察不到任何差别，硬分一个类只会是噪音。它们因此落在那个共享的
      // 未分类桶里，行为与加值类型批次之前逐位相同。
      id: "examplemod:cutpurse_training",
      display_name_key: "examplemod:cutpurse_training_display_name",
      granted_skills: ["examplemod:backstab"],
      rule_modifiers: [
        { kind: "inspection-suspicion", inconspicuous_modifier: 9 },
        { kind: "inspection-concealment", concealment_modifier: 9 },
        // 优势：扒手训练教的是「被拦下之后怎么应付」，落在**盘查**
        // 判定上，与上面那条 inconspicuous_modifier 同一环。这是
        // RuleModifier::Advantage 在本仓库的第一条真实内容声明——该
        // 变体自落地起就没有消费者，等的正是这套判定系统。
        //
        // 刻意不同时给藏匿判定优势：那会让同一条天赋在盘查链路的两环
        // 上都拿到优势，强得没有道理，也让「两环是两条独立被动」这条
        // 设计意图看不出来。
        { kind: "advantage", check_context: "lostland:inspection" },
      ],
    },
  ],
}
