// 本体物品名册——三十六条（本批次新增六件家具，全部追加在文件末尾，
// 理由见那一节的注释「为什么追加在文件末尾」）。
//
// 搬家来历见 races.json5 文件头。schema 见
// `crates/ll-mod/src/content_schema_gear.rs` 的 `ItemFile`。
//
// ── 这个文件为什么现在才存在 ────────────────────────────────────
//
// 在此之前本体一件物品都没有：耐久、标签、保温、装备槽位、配方这五套
// 机制的**真实内容证据全部落在 mods/example_mod/**，`lostland` 命名
// 空间下是空表。ADR 0018（5e61f3c 修订版）要求「玩法层内容必须能从
// mod 内容注册，且要有真实 mod 内容为证」——example_mod 证明的是
// 「第三方 mod 做得到」，本文件证明的是「**本体自己**除了 mod 内容
// 之外没有别的物品来源」，后者更强。
//
// ── 数值量级从哪来 ──────────────────────────────────────────────
//
// 没有任何数据支撑，是一批内容参数。取值参照两处既有事实，不是凭空拍：
//
//   * `base_weight` / `base_price` 都是 `Milli`（千分之一单位），量级
//     对齐 mods/example_mod/items.json5：铁锭 2000/4000、生肉 500/300、
//     一把成品铁剑 3000/50000。本文件的起始档装备一律略低于 example_mod
//     的同类（本体这批是「开局能做出来的东西」，example_mod 那批是
//     示范用的成品档）。
//   * `stat_bonuses` 的 `armor` / `insulation` 对齐 example_mod：木盾
//     armor 8、羊毛内衬 insulation 50、毛皮斗篷 insulation 90。属性类
//     加成（strength/willpower/luck……）取 +1~2，因为属性本身的值域是
//     10~30（`ll_world::entity::BaseStats`），+6 那种量级属于
//     example_mod 战锤那类高档货，不该出现在起始档。
//   * `max_durability` 取整数 40~200，量级同 example_mod（粗劣匕首 20、
//     木盾 80、铁剑 100、战锤 150）。越是「一下一下敲」的工具给得越高
//     （铁匠锤 200），越是消耗性的越低（骨针 60）。
//
// ── 耐久与标签怎么配对 ──────────────────────────────────────────
//
// 磨损通道由**标签**决定（tags.json5：armor → on-hit，weapon/tool →
// on-use），耐久上限由**物品**声明。两者必须成对出现才有意义：
//
//   * 带 `lostland:armor` 且有耐久 → 挨打掉耐久（护甲、衣物）
//   * 带 `lostland:weapon` 或 `lostland:tool` 且有耐久 → 使用掉耐久
//   * **没有任何标签的东西不给耐久**：琥珀坠/旅人指环/野外食谱三条
//     刻意不写 `max_durability`。给一件没有磨损通道的东西配一条耐久，
//     等于声明一个永远不会变化的数字——那正是「声明了没人读」。
//     反过来「可装备但没有耐久」本身是合法且想要的形状（首饰不会因为
//     挨打而碎），本文件用这三条把它写下来。
//
// ── 可堆叠 vs 逐实例 ────────────────────────────────────────────
//
// 材料与消耗品可堆叠（`stack_limit > 1`）且**一律不带耐久**——注册期
// 硬校验会拒绝（`content_schema_gear::define_one_item`：能堆叠暗示多份
// 同质可以共存一格，有耐久暗示每份实例携带自己的状态，两条字面矛盾）。
// 装备一律 `stack_limit: 1`。
{
  items: [
    // ───────────────────── 材料（可堆叠，无耐久） ─────────────────────

    // 铁锭：锻造这一路的基础材料，同时是 iron_rivet_batch 的唯一输入。
    // 数值逐字取 example_mod 的同名物，两个命名空间下的「一块铁锭」
    // 该是一样重、一样贵的东西。
    {
      id: "lostland:iron_ingot",
      display_name_key: "lostland:item.iron_ingot.display_name",
      stack_limit: 50,
      base_weight: 2000,
      base_price: 4000,
    },

    // 铁铆钉：iron_rivet_batch 一次出八颗（product_count > 1 的证据），
    // 又是两条进阶锻造配方的辅料。堆叠上限 99 与 example_mod 的箭矢
    // 同档——小、多、论把数的东西。
    {
      id: "lostland:iron_rivet",
      display_name_key: "lostland:item.iron_rivet.display_name",
      stack_limit: 99,
      base_weight: 60,
      base_price: 400,
    },

    // 亚麻布：裁缝这一路的基础材料。
    {
      id: "lostland:linen_cloth",
      display_name_key: "lostland:item.linen_cloth.display_name",
      stack_limit: 50,
      base_weight: 200,
      base_price: 600,
    },

    // 皮革条：跨类别的辅料（锻造用来缠柄，裁缝用来缝边）。
    {
      id: "lostland:leather_strip",
      display_name_key: "lostland:item.leather_strip.display_name",
      stack_limit: 50,
      base_weight: 300,
      base_price: 900,
    },

    // 毛皮：毛皮披风的主料。比皮革条重且贵得多——一整张皮 vs 一根条。
    {
      id: "lostland:fur_pelt",
      display_name_key: "lostland:item.fur_pelt.display_name",
      stack_limit: 20,
      base_weight: 800,
      base_price: 2200,
    },

    // 草药束：炼金与烹饪两个类别都用得到，是「同一味材料喂两条不同
    // 手艺」的样本。
    {
      id: "lostland:herb_bundle",
      display_name_key: "lostland:item.herb_bundle.display_name",
      stack_limit: 20,
      base_weight: 100,
      base_price: 250,
    },

    // 生肉：烹饪那两条配方的输入。
    {
      id: "lostland:raw_meat",
      display_name_key: "lostland:item.raw_meat.display_name",
      stack_limit: 20,
      base_weight: 500,
      base_price: 300,
    },

    // ─────────────── 消耗品（可堆叠，无耐久，有使用效果） ───────────────

    // 烤肉：烹饪那两条配方共同的成品，也是本体唯一一件恢复耐力的东西。
    // 恢复量 25 取 example_mod 治疗药水（40 点法力）的六成——一份烤肉
    // 不该顶一瓶药水。
    {
      id: "lostland:roast_meat",
      display_name_key: "lostland:item.roast_meat.display_name",
      stack_limit: 20,
      base_weight: 400,
      base_price: 900,
      use_effect: { kind: "restore-resource", amount: 25, resource: "stamina" },
    },

    // 草药汤剂：炼金的成品。恢复 30 点法力，同样略低于 example_mod
    // 那瓶 40 点的治疗药水（那是示范用的成品档，这是开局能煮出来的）。
    {
      id: "lostland:herbal_draught",
      display_name_key: "lostland:item.herbal_draught.display_name",
      stack_limit: 10,
      base_weight: 300,
      base_price: 1800,
      use_effect: { kind: "restore-resource", amount: 30, resource: "mana" },
    },

    // ───────────────────────── 武器（on-use 磨损） ─────────────────────────

    // 铁短剑：本体唯一一件**引用本体伤害公式**的物品。物品级公式覆盖
    // 这条能力在此之前只有 example_mod 用得上
    // （examplemod:iron_sword_formula / examplemod:flame_longbow_formula），
    // 本体侧一件都没有。
    //
    // 引用的是 mods/lostland/damage_formulas.json5 里新写的
    // `lostland:blade_damage_formula`，**不是**引擎注册的
    // `lostland:default_damage_formula`——后者是「把攻击力原样交回去」，
    // 在物品这一级填上它与整条不写逐位等价，理由见那个文件的文件头。
    //
    // **不声明 damage_category**：本体唯一的伤害类别 `lostland:physical`
    // 正是全局默认类别，显式写上它同样是一处与不写等价的噪音，见
    // content_audit 里 `ItemAttrs::damage_category` 那条字段豁免。
    {
      id: "lostland:iron_shortsword",
      display_name_key: "lostland:item.iron_shortsword.display_name",
      stack_limit: 1,
      base_weight: 2400,
      base_price: 40000,
      max_durability: 120,
      equip_slots: ["main-hand", "off-hand"],
      damage_formula: "lostland:blade_damage_formula",
      tags: ["lostland:weapon"],
    },

    // 战镐：同时带 weapon 与 tool 两条标签——项目所有者原话「修理锤子
    // 也算是一种武器，也可以是带有功能性的物品」说的正是这种东西。
    // 两条标签今天走同一个磨损通道（on-use），因此它的磨损行为与只带
    // 一条没有区别；写两条是为了回答两个不同的问题（能打人吗 / 能干活
    // 吗），见 tags.json5「为什么 tool 与 weapon 不合并」一节。
    //
    // 穿透 { flat: 2, permille: 150 }：本体唯一一处穿透声明。量级取
    // example_mod 战锤（flat 3 / permille 100）的同一档，把固定值调低、
    // 百分比调高——镐是靠尖端集中受力破甲的，对重甲比对轻甲更有效，
    // 百分比穿透正是这个语义。
    {
      id: "lostland:iron_warpick",
      display_name_key: "lostland:item.iron_warpick.display_name",
      stack_limit: 1,
      base_weight: 3200,
      base_price: 55000,
      max_durability: 110,
      equip_slots: ["main-hand"],
      penetration: { flat: 2, permille: 150 },
      tags: ["lostland:weapon", "lostland:tool"],
    },

    // 橡木圆盾：同时带 armor 与 weapon——盾能挡也能砸，所有者原话
    // 「有的技能像是盾击，他也会变成武器这样」。两条标签意味着它走
    // **两条**磨损通道：持有者挨打时磨损（armor → on-hit），拿它砸人
    // 时也磨损（weapon → on-use）。本体唯一一件双通道物品。
    //
    // 减伤走 `armor` 而**不是** `resistances`：抗性表达的是「对某一类
    // 伤害特别抗」，而本体今天只有 `lostland:physical` 这一个伤害类别
    // ——对唯一的那一类声明抗性，实际语义是「对所有伤害按比例减免」，
    // 那正是护甲值这个字段的职责。理由的完整版见 content_audit 里
    // `ItemAttrs::rule_modifiers` 那条字段豁免。
    //
    // armor 7 略低于 example_mod 木盾的 8：小圆盾比整面木盾挡得少。
    {
      id: "lostland:oak_buckler",
      display_name_key: "lostland:item.oak_buckler.display_name",
      stack_limit: 1,
      base_weight: 3500,
      base_price: 11000,
      max_durability: 90,
      equip_slots: ["off-hand"],
      stat_bonuses: [{ target: "armor", amount: 7 }],
      tags: ["lostland:armor", "lostland:weapon"],
    },

    // 锻炉烙铁：本体唯一一件**显式声明伤害类别**的武器——打的是
    // `lostland:fire`，不是全局默认的 `lostland:physical`。第二个本体
    // 伤害类别落地之前，这个字段在本体侧写不出有意义的值，
    // content_audit 为此挂过一条字段豁免；那条豁免随本条内容摘除，
    // 理由见 mods/lostland/damage_categories.json5 文件头。
    //
    // 它与铁短剑正好组成**正交的两半**，这正是想写下来的事：
    //
    //   * 铁短剑：声明 `damage_formula`，不声明 `damage_category`；
    //   * 锻炉烙铁：声明 `damage_category`，不声明 `damage_formula`。
    //
    // 「伤害公式」与「伤害类别」是两条互不相干的轴
    // （`damage-formula-mod-api.md` 十七节「正交，不合并」）：烙铁不写
    // 公式就沿三级下探落到全局默认（把攻击力原样交回去），这对一件
    // 「靠烧不靠挥」的东西恰好合适——它的特别之处在**挡不挡得住**，
    // 不在**打多少**。
    //
    // 数值：耐久 70 低于铁短剑的 120（烧红的铁反复淬冷会脆）；价格
    // 21000 约为铁短剑的一半——它不吃 str-mod 那条二阶收益，纯论
    // 伤害是把弱兵器，贵的是「有些东西只有火打得动」这件事。
    // 只带 weapon 一条标签：它不是任何配方的 required_tool，与铁匠锤
    // 「只带 tool 不带 weapon」正好对称。
    {
      id: "lostland:forge_brand",
      display_name_key: "lostland:item.forge_brand.display_name",
      stack_limit: 1,
      base_weight: 2600,
      base_price: 21000,
      max_durability: 70,
      equip_slots: ["main-hand"],
      damage_category: "lostland:fire",
      tags: ["lostland:weapon"],
    },

    // ───────────────────────── 工具（on-use 磨损） ─────────────────────────

    // 铁匠锤：三条锻造配方的 required_tool。**只带 tool 不带 weapon**
    // ——与上面的战镐正好组成对照：一把纯工具，抡起来也能打人但内容
    // 不这么声明。耐久 200 是全表最高：它是被反复使用的那一端，不是被
    // 消耗的那一端。
    {
      id: "lostland:smith_hammer",
      display_name_key: "lostland:item.smith_hammer.display_name",
      stack_limit: 1,
      base_weight: 2800,
      base_price: 25000,
      max_durability: 200,
      equip_slots: ["main-hand"],
      tags: ["lostland:tool"],
    },

    // 骨针：两条裁缝配方的 required_tool。占 hand-r 槽而不是 main-hand
    // ——这样「一手拿针一手拿布」不必和武器抢主手槽。耐久 60 偏低：
    // 骨针是会断的。
    {
      id: "lostland:bone_needle",
      display_name_key: "lostland:item.bone_needle.display_name",
      stack_limit: 1,
      base_weight: 20,
      base_price: 1500,
      max_durability: 60,
      equip_slots: ["hand-r"],
      tags: ["lostland:tool"],
    },

    // ───────────────────────── 家具（放在地上的可交互物品） ─────────────────────────

    // 锻炉：本体第一件**家具**（`furniture: true`）。项目所有者裁定
    // 「家具也应该算是一种可以放在地形上的可交互物品」——它就是一件
    // 普通物品，背得动、丢得下、捡得起，只是丢下去那一刻会占住脚下
    // 那一格、永远不老化消失，并且成为三条锻造配方的 required_station。
    //
    // 它替掉的是 crafting.json5 里那处**明知的将就**（拿石地面当铁匠
    // 铺地面）——那条注释原话就写着「等有了家具层，本条与下面两条进阶
    // 锻造配方的 required_station 一起改指过去即可」。
    //
    // 不可堆叠（注册期硬校验：家具必须 stack_limit: 1，一格上摆的是
    // 一座锻炉不是一摞）。不带耐久、不带任何标签：它不装备、不挨打、
    // 也不是任何配方的 required_tool（锻造要的工具是铁匠锤，场地才是
    // 它），给它配一条永远不变的耐久数字正是「声明了没人读」。
    //
    // 40000 是全表最贵的一档：六块铁锭（24000）加上把它们砌成一座炉子
    // 这件事本身。100000 的重量（100 单位）说的是「你**背得动**但背着
    // 它走不远」——这是家具与随身工具真正的分界，也是「造在营地里」这
    // 条玩法自然的来源。
    {
      id: "lostland:forge",
      display_name_key: "lostland:item.forge.display_name",
      stack_limit: 1,
      base_weight: 100000,
      base_price: 40000,
      furniture: true,
    },

    // ───────────────────────── 护甲（on-hit 磨损） ─────────────────────────

    // 铁盔：iron_helm_recipe 的成品（进阶锻造类别，要工匠副职）。
    {
      id: "lostland:iron_helm",
      display_name_key: "lostland:item.iron_helm.display_name",
      stack_limit: 1,
      base_weight: 2200,
      base_price: 18000,
      max_durability: 100,
      equip_slots: ["head"],
      stat_bonuses: [{ target: "armor", amount: 5 }],
      tags: ["lostland:armor"],
    },

    // 皮甲衣：**同一件东西同时给 armor 与 insulation** 的样本——皮子
    // 既挡刀也挡风，两条加成走的是同一段求和算法
    // （`ll_sim::item::StatTarget`），不需要两件装备分别提供。
    {
      id: "lostland:leather_jerkin",
      display_name_key: "lostland:item.leather_jerkin.display_name",
      stack_limit: 1,
      base_weight: 3000,
      base_price: 16000,
      max_durability: 110,
      equip_slots: ["body"],
      stat_bonuses: [
        { target: "armor", amount: 6 },
        { target: "insulation", amount: 30 },
      ],
      tags: ["lostland:armor"],
    },

    // 铁胫甲：iron_greaves_recipe 的成品（进阶锻造）。
    {
      id: "lostland:iron_greaves",
      display_name_key: "lostland:item.iron_greaves.display_name",
      stack_limit: 1,
      base_weight: 2600,
      base_price: 15000,
      max_durability: 100,
      equip_slots: ["legs"],
      stat_bonuses: [{ target: "armor", amount: 4 }],
      tags: ["lostland:armor"],
    },

    // 皮靴：一件东西占**两个**槽位（左右靴各一），与 example_mod 战锤
    // 「双手都能拿」是同一个字段的两种用法——那里是「二选一」，这里
    // 是「一双」。槽位掩码本身不区分这两种语义，区别在内容设计。
    {
      id: "lostland:leather_boots",
      display_name_key: "lostland:item.leather_boots.display_name",
      stack_limit: 1,
      base_weight: 1200,
      base_price: 9000,
      max_durability: 80,
      equip_slots: ["boot-l", "boot-r"],
      stat_bonuses: [
        { target: "armor", amount: 2 },
        { target: "insulation", amount: 15 },
      ],
      tags: ["lostland:armor"],
    },

    // ─────────────── 衣物（保温为主，同样 on-hit 磨损） ───────────────

    // 亚麻衬衣：linen_shirt_recipe 的成品，全表最便宜的一件装备。
    // 只保温、不挡刀（没有 armor 加成）——保温与护甲是两个独立的目标，
    // 一件衣服可以只有其中一个。
    {
      id: "lostland:linen_shirt",
      display_name_key: "lostland:item.linen_shirt.display_name",
      stack_limit: 1,
      base_weight: 500,
      base_price: 3000,
      max_durability: 50,
      equip_slots: ["body"],
      stat_bonuses: [{ target: "insulation", amount: 20 }],
      tags: ["lostland:armor"],
    },

    // 毛皮披风：fur_mantle_recipe 的成品，占 outer 槽——与占 body 槽的
    // 衬衣/皮甲衣**可以同时穿**，两层保温相加，这正是温度系统
    // （c12c04f）想要的补给循环。insulation 80 略低于 example_mod 的
    // 毛皮斗篷（90），理由同全表：本体这批是开局档。
    {
      id: "lostland:fur_mantle",
      display_name_key: "lostland:item.fur_mantle.display_name",
      stack_limit: 1,
      base_weight: 4200,
      base_price: 26000,
      max_durability: 90,
      equip_slots: ["outer"],
      stat_bonuses: [{ target: "insulation", amount: 80 }],
      tags: ["lostland:armor"],
    },

    // 锻炉围裙：本体唯一一件**声明抗性**的物品（`resistances`，落进
    // `ItemAttrs::rule_modifiers`）。content_audit 为这条字段挂过一条
    // 豁免，理由是「对本体唯一的、又是全局默认的那一类声明抗性，语义
    // 等同于 armor」——`lostland:fire` 落地之后那条理由不再适用，豁免
    // 随本条内容摘除。
    //
    // **这才是抗性该被用来表达的东西**：不是「挨打少掉血」（那是
    // armor 的职责，橡木圆盾走的就是那条），而是「对某一类特别抗」。
    // 一件浸过盐水的厚皮围裙对火星有用，对刀子没用——它因此 armor 只
    // 有 2（聊胜于无），对火却有 6 点减伤。
    //
    // ── 加值类型（`modifier_type`）：lostland:gear ──────────────────
    //
    // 这条抗性此前**刻意不声明**加值类型，理由是「本体没有名册，而造
    // 一份是一条独立的内容设计裁定」。项目所有者已经做掉那条裁定
    // （mods/lostland/modifier_types.json5，见其文件头），本条随之
    // 归类。
    //
    // 归类不是形式主义：不声明 ≠ 自成一桶，而是落进**未分类共享桶**
    // （`ll_sim::rule_modifier` 模块文档「加值类型」一节：未声明类型的
    // 全部进同一个桶，桶内取最强）。也就是说，此前任何一个 mod 写的、
    // 同样没声明类型的火抗，都在与这 6 点**互相竞争**——mod 的 +3 不会
    // 与它相加，而是被它静默吃掉。声明 gear 之后本条有了自己的桶。
    //
    // 槽位是 outer，与毛皮披风（insulation 80）**互斥**——这是刻意的
    // 取舍：出门是穿暖和的还是穿防火的，一次只能选一样。
    {
      id: "lostland:forge_apron",
      display_name_key: "lostland:item.forge_apron.display_name",
      stack_limit: 1,
      base_weight: 3800,
      base_price: 19000,
      max_durability: 85,
      equip_slots: ["outer"],
      stat_bonuses: [{ target: "armor", amount: 2 }],
      resistances: [
        {
          damage_category: "lostland:fire",
          damage_reduction: 6,
          modifier_type: "lostland:gear",
        },
      ],
      tags: ["lostland:armor"],
    },

    // 羊毛手套：占 hand-l 与 hand-r 两个槽（一双）。注意它与骨针**抢
    // hand-r**——戴着手套穿不了针，这条冲突是内容设计的自然结果，不是
    // 疏漏。
    {
      id: "lostland:wool_gloves",
      display_name_key: "lostland:item.wool_gloves.display_name",
      stack_limit: 1,
      base_weight: 250,
      base_price: 2500,
      max_durability: 40,
      equip_slots: ["hand-l", "hand-r"],
      stat_bonuses: [{ target: "insulation", amount: 12 }],
      tags: ["lostland:armor"],
    },

    // ─────────────── 饰品（可装备，**刻意无耐久、无标签**） ───────────────

    // 琥珀坠：属性加成走 `willpower`，不是 armor/insulation——
    // `StatTarget` 的第三种取值（七个属性之一）在本体侧此前一处内容
    // 都没有。+2 相对 10~30 的属性值域是一档明显但不夸张的加成。
    {
      id: "lostland:amber_pendant",
      display_name_key: "lostland:item.amber_pendant.display_name",
      stack_limit: 1,
      base_weight: 120,
      base_price: 12000,
      equip_slots: ["neck"],
      stat_bonuses: [{ target: "willpower", amount: 2 }],
      // 未鉴定：一块琥珀里封着什么、值不值钱，得先看懂了才知道。
      // **属性照常生效**——没鉴定过一样加 2 点意志，只是背包里显示成
      // 「未鉴定的物品」，见 Agent::identified_items 文档。
      requires_identification: true,
      study_experience: 30,
    },

    // 旅人指环：左右手指各能戴一枚（同一件物品定义、两个槽位）。
    // 幸运 +1——幸运在结算里影响面广，给到 +2 会比琥珀坠的 +2 意志值钱
    // 得多，因此压到 +1。
    {
      id: "lostland:traveler_ring",
      display_name_key: "lostland:item.traveler_ring.display_name",
      stack_limit: 1,
      base_weight: 60,
      base_price: 20000,
      equip_slots: ["ring-l", "ring-r"],
      stat_bonuses: [{ target: "luck", amount: 1 }],
      // 同琥珀坠。经验略低：一枚常见的旅人指环没有琥珀坠那么值得研究。
      requires_identification: true,
      study_experience: 25,
    },

    // ─────────── 未鉴定物（`requires_identification` 的其余证据） ───────────

    // 蒙尘印戒：本体唯一一件**只**靠鉴定才认得出好坏的戒指。与旅人
    // 指环同槽位、同形态，差别全在数值——正是「不鉴定就分不出这两枚
    // 戒指哪枚好」这个玩法的直接落点。
    {
      id: "lostland:tarnished_signet",
      display_name_key: "lostland:item.tarnished_signet.display_name",
      stack_limit: 1,
      base_weight: 70,
      base_price: 26000,
      equip_slots: ["ring-l", "ring-r"],
      stat_bonuses: [{ target: "charisma", amount: 2 }],
      requires_identification: true,
      study_experience: 35,
    },

    // 无标小瓶：**可堆叠**的未鉴定物——鉴定的粒度是「种类」不是「某一
    // 堆」，这一条就是那条裁定的内容证据：认出一瓶之后，背包里同种的
    // 全部小瓶一起变得认得，此后捡到的也认得（见
    // `Agent::identified_items` 文档「粒度是种类，不是某一堆」）。
    //
    // 恢复量与草药汤剂相同（30 点法力）——刻意相同：喝下去的效果与认不
    // 认得它无关，「未鉴定不改变任何结算」这条裁定在内容层就是这么长的。
    {
      id: "lostland:unmarked_phial",
      display_name_key: "lostland:item.unmarked_phial.display_name",
      stack_limit: 10,
      base_weight: 300,
      base_price: 2400,
      use_effect: { kind: "restore-resource", amount: 30, resource: "mana" },
      requires_identification: true,
      study_experience: 15,
    },

    // ───────────────────────── 盲盒 ─────────────────────────

    // 封蜡遗物匣：本体唯一一件盲盒。项目所有者原话「我希望能加入盲盒
    // 这种物品，鉴定了可以获取经验，同时会随机获得一件物品或者武器
    // 装备」。
    //
    // 与上面那几件未鉴定物**本质不同**：普通鉴定是**揭示**（东西还在，
    // 只是你现在认得它了），开盒是**转化**（盒子没了，换成里面那件）。
    // 见 `ll_sim::resolve::resolve_identify` 文档开头那张对照表。
    //
    // 权重合计 100，一眼能读出概率：铁锭 50%、亚麻布 30%、草药束 15%、
    // 铁短剑 5%。稀有档（那把剑）值 40000，普通档（一块铁锭 ×2）值
    // 8000——五个百分点换五倍价值，是「多数时候开出普通货、偶尔开出好
    // 东西」这条盲盒玩法该有的形状。
    //
    // **⚠ 不要给这个盒子写配方，也不要让它可购买**：开盒**每次**都给
    // study_experience（项目所有者裁定「开盲盒都给吧，轻松点，这是
    // 游戏」），今天无害是因为盒子只能从世界里捡到、数量有限。一旦它
    // 可制作或可购买，经验产出的上限就没了。完整论证见
    // `ll_mod::item::ItemDef::blind_box_pool` 文档。
    //
    // 20 点经验略低于同价位的未鉴定饰品（25~35）：开盒的乐趣主要在
    // 产出物，不在「研究」本身。
    {
      id: "lostland:sealed_relic_box",
      display_name_key: "lostland:item.sealed_relic_box.display_name",
      stack_limit: 1,
      base_weight: 1500,
      base_price: 15000,
      requires_identification: true,
      study_experience: 20,
      blind_box_pool: [
        { item: "lostland:iron_ingot", count: 2, weight: 50 },
        { item: "lostland:linen_cloth", count: 2, weight: 30 },
        { item: "lostland:herb_bundle", count: 3, weight: 15 },
        { item: "lostland:iron_shortsword", count: 1, weight: 5 },
      ],
    },

    // ───────────────────────────── 书 ─────────────────────────────

    // 野外食谱：本体唯一一件 `taught_recipes` 物品，也是「一开始什么都
    // 不会」这条裁定的**第二条**出路——第一条是乱煮
    // （`Intent::Experiment`），这条是读书。两条路径互补而不是互为备份：
    // 读书不受配方类别的副职闸门约束（`resolve_read` 完全不查类别），
    // 试做受约束。
    //
    // 它教的是烤肉这条最基础的配方：本体全部配方现在都要先被发现，
    // 「新角色连烤肉都不会」是所有者要的效果，而这本书是那道门的钥匙
    // 之一。id 拼错的症状是**这本书静默什么都不教**，注册期的配方表
    // 查表与 content_audit 的跨表引用校验各拦一道。
    {
      id: "lostland:field_cookbook",
      display_name_key: "lostland:item.field_cookbook.display_name",
      stack_limit: 1,
      base_weight: 600,
      base_price: 9000,
      taught_recipes: ["lostland:roast_meat_recipe"],
      // 研读经验（研究经验收窄批次）——项目所有者把研究类经验收窄成
      // 「未鉴定物品与书籍」两条来源，这是书籍那一条在本体的唯一证据。
      // **只有真的教到新配方那一次才给**：读第二遍恒零收益，见
      // `ll_sim::resolve::resolve_read` 文档。它不需要鉴定（书就是书，
      // 一眼认得），因此 requires_identification 整条不写。
      study_experience: 40,
    },

    // ────────── 家具第二批（住宅 / 作坊 / 仓库 / 酒馆四类建筑的陈设） ──────────
    //
    // 项目所有者裁定原话：「建筑需要根据他的类型填入不同的家具，例如
    // 箱子，椅子，床，书柜等」。上面那件锻炉是家具层落地时的**唯一**
    // 一件，只够作坊用；本节补的六件让四类建筑各自有至少两样说得通的
    // 东西可摆：
    //
    //   | 家具       | 住宅 | 作坊 | 仓库 | 酒馆 |
    //   | 锻炉（上面）|      |  ✓   |      |      |
    //   | 橡木椅     |  ✓   |  ✓   |      |  ✓   |
    //   | 橡木长桌   |  ✓   |  ✓   |      |  ✓   |
    //   | 毛皮卧铺   |  ✓   |      |      |  ✓   |
    //   | 橡木书柜   |  ✓   |  ✓   |      |      |
    //   | 橡木酒桶   |      |      |  ✓   |  ✓   |
    //   | 铁箍箱     |  ✓   |      |  ✓   |      |
    //
    // **只有六件，不凑目录**（YAGNI / ADR 0021）：判据是「四类建筑各自
    // 空不空」，不是「一份家具清单该有多少条」。刻意没加的是织机、
    // 鞣皮架那类「第二座作坊场地」——它要么当 `required_station`（那就
    // 得回头收紧既有两条裁缝配方的前置，是一次玩法改动，不该夹带在
    // 内容批次里），要么不当（那就是一件声明了没人读的家具）。
    //
    // ── 为什么追加在文件末尾，而不是挨着上面那件锻炉 ──────────────
    //
    // 物品在 `ll_mod::content_data` 的 `CONTENT_FILES` 里排在**种族 /
    // 文化 / 职业 / 技能 / 天赋 / 任务之前**，而 `ContentIndex` 按装载
    // 顺序分配。插在文件中间会把其后每一条内容（含另外六个文件里的
    // 全部条目）的索引整体平移——气候条带批次正是这样被
    // `crates/ll-sim/tests/replay.rs` 当场咬住的（两种新地形起初插在
    // `snow` 之后，其后九种地形索引平移 2，带宽归零也回不到旧值）。
    // 追加在末尾是唯一不需要论证的位置。
    //
    // ── 这六件为什么都没有耐久、没有标签 ──────────────────────────
    //
    // 与锻炉那条逐字同构，理由在引擎侧是可核实的：磨损只有两条通道，
    // `ON_HIT` 读的是「持有者挨打时**身上装备着**的东西」、`ON_USE`
    // 读的是「**装备着的**工具/武器被使用」（`ll_sim::resolve` 里
    // `wear_channels` 的两处读取点）。立在地上的家具两条都碰不到，
    // 配一条耐久等于声明一个永远不会变化的数字。
    //
    // ── 为什么都不写 use_effect ────────────────────────────────────
    //
    // `ll_sim::resolve::resolve_use_item` **无条件**先产出一条
    // `Effect::ConsumeInventoryItem` 再谈效果。给卧铺配一条「恢复
    // 耐力」的直接后果是：睡一次，床没了。「躺在摆好的床上休息」是
    // 交互列表那一侧的事（`Intent::Interact`），不是 `use_effect`。
    //
    // ── 重量与价格的量级 ──────────────────────────────────────────
    //
    // 全部低于锻炉（重 100000 / 价 40000，本表最贵最重的一档），高于
    // 随身工具（铁匠锤 2800）。这条区间就是家具的定义域：背得动、但
    // 背着它走不远。价格对齐既有档位——一件起始档护甲 15000~18000、
    // 一把铁短剑 40000。

    // 橡木椅：全组最轻最便宜的一件，住宅与酒馆各摆几把。
    // 6000（6 单位）比一把铁短剑（2400）重一倍半：一把木椅确实比一把
    // 剑沉，但两个人抬得动。
    {
      id: "lostland:oak_chair",
      display_name_key: "lostland:item.oak_chair.display_name",
      stack_limit: 1,
      base_weight: 6000,
      base_price: 3000,
      furniture: true,
    },

    // 橡木长桌：酒馆的主家具，作坊里也当工作面。重量 26000 是椅子的
    // 四倍多——一张长桌就是四把椅子的木料摊开摆平。
    //
    // **它不是 `required_station`**：把桌子设成制作场地会让「有没有桌子」
    // 成为裁缝/烹饪配方的硬前置，那是一次玩法收紧，属于配方数值批次的
    // 决定，不该由一件新家具顺手带进来。
    {
      id: "lostland:oak_table",
      display_name_key: "lostland:item.oak_table.display_name",
      stack_limit: 1,
      base_weight: 26000,
      base_price: 8000,
      furniture: true,
    },

    // 毛皮卧铺：所有者点名的「床」。本体没有木料这种原材料（见下面
    // 铁箍箱那条的完整论证），所以本体的床是**一卷铺开的毛皮**而不是
    // 一张木床架——这不是将就，是让它能真的被造出来：
    // `lostland:fur_bed_recipe` 用的四张毛皮加三幅亚麻布全部是本体已有
    // 的材料，与毛皮披风同一条裁缝路。
    //
    // 因此它是全组**最轻**的一件（9000，比长桌轻得多，只比一件毛皮
    // 披风 4200 重一倍）。重量要诚实：一卷毛皮就是一卷毛皮，给它安一个
    // 木床架的重量会让「背得动但走不远」这条家具判据在第一件东西上就
    // 说不通。价格 24000 略低于毛皮披风的 26000——用料更多但做工更糙，
    // 披风要合身，铺盖只要够大。
    {
      id: "lostland:fur_bed",
      display_name_key: "lostland:item.fur_bed.display_name",
      stack_limit: 1,
      base_weight: 9000,
      base_price: 24000,
      furniture: true,
    },

    // 橡木书柜：住宅（识字人家）与作坊（配方与账册）。
    //
    // 它今天**不装书**——`GroundItemStack::contents` 的容器语义见下面
    // 铁箍箱那条注释，两件东西卡在同一条尚未裁定的账上。书柜先是一件
    // 立在那儿的家具，与野外食谱（`lostland:field_cookbook`）之间今天
    // 没有任何机制关系。
    //
    // 32000 是全组最重：一面顶到房梁的柜子。价格 13000 高于长桌——同样
    // 的木料，隼卯格挡多、做工细。
    {
      id: "lostland:oak_bookshelf",
      display_name_key: "lostland:item.oak_bookshelf.display_name",
      stack_limit: 1,
      base_weight: 32000,
      base_price: 13000,
      furniture: true,
    },

    // 橡木酒桶：仓库与酒馆。同样**不装东西**（理由同书柜与铁箍箱）。
    // 20000／6000：一只空桶比长桌轻、比椅子重，且便宜——桶是消耗品档
    // 的木器，箍好就用，不讲究。
    {
      id: "lostland:oak_barrel",
      display_name_key: "lostland:item.oak_barrel.display_name",
      stack_limit: 1,
      base_weight: 20000,
      base_price: 6000,
      furniture: true,
    },

    // 铁箍箱：所有者点名的「箱子」，仓库与住宅。全组最重最贵
    // （45000 / 26000）——木壳之外还有铁箍、铁角与合页，
    // `lostland:iron_bound_chest_recipe` 打的正是那些铁件。
    //
    // ── ⚠ 它今天**不是容器**，这是刻意的，不是忘了 ────────────────
    //
    // `ll_world::item::GroundItemStack` 已经有 `contents` 字段，但它
    // 今天唯一的消费者是**尸体**（`append_corpse_drop` 把遗物塞进
    // 尸体的 contents），而项目所有者已经裁定把尸体改成「尸体与遗物
    // 平铺进同一格的掉落列表」——那一改等于取消尸体的容器身份，
    // `contents` 会**空出来**。
    //
    // 箱子才是那个字段将来的正经消费者（「打开箱子 → 里面另有一份
    // 物品列表」正是它被设计出来要表达的东西），但把它接上去要与尸体
    // 那一批**同批裁定**：拾取路径今天把 `contents` 非空的地面物品
    // 整体排除在合并与拾取之外（`resolve_pick_up`），先给箱子灌上
    // contents 会当场造出一件捡不起来的家具。
    //
    // 所以本批的箱子就是一件普通家具：能造、能摆、能收回背包，肚子
    // 是空的。**下一个读到这里的人**：要接容器语义，请连同尸体那条
    // 一起裁定，不要只改这一件。
    {
      id: "lostland:iron_bound_chest",
      display_name_key: "lostland:item.iron_bound_chest.display_name",
      stack_limit: 1,
      base_weight: 45000,
      base_price: 26000,
      furniture: true,
    },

    // ───────────────────── 树木（批次 32，追加在文件末尾） ─────────────────────
    //
    // 两件，闭环：采 → 得种 → 种 → 长树 → 砍 → 得木料。
    //
    // ── 为什么只有两件 ─────────────────────────────────────────────
    //
    // 三种树（橡/松/棕榈）共用这同一对产出物，树种只决定**砍下来几份
    // 木料**（`ll_world::tree::TreeSpecies::timber_yield`：3/2/1）。给每
    // 种树各开一套木料与种子会造出六条谁也没消费的内容——项目所有者的
    // 指示原话是「宁可少而扎实：一个树种把砍/种/采三条路走通做透，好过
    // 五个树种但没人验过」。
    //
    // 「果子」与「种子」也刻意是**同一件东西**：单开一件果子需要食物
    // 系统那一路才有消费者，而食物系统不在本批范围，那件果子会当场变成
    // 「声明了没人读」。
    //
    // ── 数值量级 ───────────────────────────────────────────────────
    //
    // 木料 3000/900：比铁锭（2000/4000）**更重更便宜**——一段原木比一块
    // 铁锭沉，但没经过任何加工。参照橡木椅（9000 重 / 5000 价，成品），
    // 三段木料的料钱远低于一把成品椅子的价钱，中间那一段是手艺。
    //
    // ── ⚠ 为什么叫 `timber_log` 而不是 `timber` ───────────────────
    //
    // **`lostland:timber` 这个 id 已经被占了**：resources.json5 里的据点
    // 资源「木材」就叫这个名字。注册表是**一个** id ↔ 索引空间，两张
    // 不同的表用同一个 id 会让它们共享同一个 `ContentIndex`，此后
    // 「这个索引是哪张表的」再也问不清楚。
    //
    // **本批第一版真的踩了这一脚**（实测两者同为索引 40）。发现它的
    // 不是任何一道门禁——是「新增两条内容却只让后续索引平移了 1」这个
    // 对不上的数字。详见 `crates/ll-mod/src/tree.rs` 的 `TIMBER_ID` 文档。
    //
    // 树种 100/200：全表最轻（一颗种子）。价钱刻意**高于同重量的木料**
    // ——种子的价值在于它能长成一棵树，不在于它这点分量。
    //
    // 两件都是材料档：可堆叠、无耐久（没有磨损通道，见文件头「耐久与
    // 标签怎么配对」一节）、不是家具。
    {
      id: "lostland:timber_log",
      display_name_key: "lostland:item.timber_log.display_name",
      stack_limit: 50,
      base_weight: 3000,
      base_price: 900,
    },
    {
      id: "lostland:tree_seed",
      display_name_key: "lostland:item.tree_seed.display_name",
      stack_limit: 99,
      base_weight: 100,
      base_price: 200,
    },
  ],
}
